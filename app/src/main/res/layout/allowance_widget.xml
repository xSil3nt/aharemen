<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="aharemen" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#edf5ed" android:includeFontPadding="false"/>
        <ProgressBar android:id="@+id/widget_progress" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="8dp" android:indeterminate="true" android:indeterminateTint="#b4e7c7" android:visibility="gone"/>
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="4dp" android:gravity="end|center_vertical" android:text="Open app" android:textColor="#8fa399" android:textSize="10sp" android:maxLines="2" android:ellipsize="end"/>
        <ImageView android:id="@+id/widget_refresh" android:layout_width="30dp" android:layout_height="match_parent" android:padding="6dp" android:background="@drawable/widget_button" android:src="@drawable/ic_widget_refresh" android:contentDescription="Refresh allowances" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:id="@+id/widget_data_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_widget_data" android:importantForAccessibility="no"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data" android:textSize="11sp" android:textColor="#b6c3bd" android:includeFontPadding="false"/>
                </LinearLayout>
                <ViewFlipper android:id="@+id/widget_flip_data" android:layout_width="match_parent" android:layout_height="44dp" android:inAnimation="@anim/widget_balance_in" android:outAnimation="@anim/widget_balance_out" android:animateFirstView="false" android:autoStart="false">
                    <TextView android:id="@+id/widget_data" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center" android:text="—" android:textSize="31sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="31sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#a8ccea" android:singleLine="true" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/widget_data_next" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center" android:text="—" android:textSize="31sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="31sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#a8ccea" android:singleLine="true" android:includeFontPadding="false"/>
                </ViewFlipper>
                <TextView android:id="@+id/widget_unit_data" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MB" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_data" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp" android:background="@drawable/widget_button_data" android:text="+25 MB" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#a8ccea" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:id="@+id/widget_voice_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_widget_voice" android:importantForAccessibility="no"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calls" android:textSize="11sp" android:textColor="#b6c3bd" android:includeFontPadding="false"/>
                </LinearLayout>
                <ViewFlipper android:id="@+id/widget_flip_voice" android:layout_width="match_parent" android:layout_height="44dp" android:inAnimation="@anim/widget_balance_in" android:outAnimation="@anim/widget_balance_out" android:animateFirstView="false" android:autoStart="false">
                    <TextView android:id="@+id/widget_voice" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center" android:text="—" android:textSize="31sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="31sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#edc3a2" android:singleLine="true" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/widget_voice_next" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center" android:text="—" android:textSize="31sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="31sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#edc3a2" android:singleLine="true" android:includeFontPadding="false"/>
                </ViewFlipper>
                <TextView android:id="@+id/widget_unit_voice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="min" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_voice" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp" android:background="@drawable/widget_button_voice" android:text="+3 min" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#edc3a2" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:id="@+id/widget_sms_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_widget_sms" android:importantForAccessibility="no"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Texts" android:textSize="11sp" android:textColor="#b6c3bd" android:includeFontPadding="false"/>
                </LinearLayout>
                <ViewFlipper android:id="@+id/widget_flip_sms" android:layout_width="match_parent" android:layout_height="44dp" android:inAnimation="@anim/widget_balance_in" android:outAnimation="@anim/widget_balance_out" android:animateFirstView="false" android:autoStart="false">
                    <TextView android:id="@+id/widget_sms" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center" android:text="—" android:textSize="31sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="31sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#b4e7c7" android:singleLine="true" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/widget_sms_next" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center" android:text="—" android:textSize="31sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="31sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#b4e7c7" android:singleLine="true" android:includeFontPadding="false"/>
                </ViewFlipper>
                <TextView android:id="@+id/widget_unit_sms" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SMS" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_sms" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp" android:background="@drawable/widget_button_sms" android:text="+10 SMS" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#b4e7c7" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
