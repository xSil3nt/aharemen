<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="7dp">
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="aharemen" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="#a0a0a6" android:includeFontPadding="false"/>
        <ProgressBar android:id="@+id/widget_progress" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="8dp" android:indeterminate="true" android:indeterminateTint="#dedee2" android:visibility="gone"/>
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="4dp" android:gravity="end|center_vertical" android:text="Open app" android:textColor="#86868f" android:textSize="10sp" android:maxLines="2" android:ellipsize="end"/>
        <ImageView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="match_parent" android:padding="6dp" android:src="@drawable/ic_widget_refresh" android:contentDescription="Refresh allowances" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:id="@+id/widget_data_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Data" android:textSize="11sp" android:textColor="#a0a0a6" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_data" android:layout_width="match_parent" android:layout_height="46dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:gravity="center" android:text="—" android:textSize="30sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="17sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-light" android:textColor="#fafafa" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_unit_data" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MB" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_data" android:layout_width="match_parent" android:layout_height="38dp" android:background="@drawable/widget_button" android:text="+25 MB" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#dedee2" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="64dp" android:layout_gravity="center_vertical" android:background="#20ffffff" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:id="@+id/widget_voice_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Calls" android:textSize="11sp" android:textColor="#a0a0a6" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_voice" android:layout_width="match_parent" android:layout_height="46dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:gravity="center" android:text="—" android:textSize="30sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="17sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-light" android:textColor="#fafafa" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_unit_voice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="min" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_voice" android:layout_width="match_parent" android:layout_height="38dp" android:background="@drawable/widget_button" android:text="+3 min" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#dedee2" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="64dp" android:layout_gravity="center_vertical" android:background="#20ffffff" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:id="@+id/widget_sms_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Texts" android:textSize="11sp" android:textColor="#a0a0a6" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_sms" android:layout_width="match_parent" android:layout_height="46dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:gravity="center" android:text="—" android:textSize="30sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="17sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-light" android:textColor="#fafafa" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_unit_sms" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SMS" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_sms" android:layout_width="match_parent" android:layout_height="38dp" android:background="@drawable/widget_button" android:text="+10 SMS" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#dedee2" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
