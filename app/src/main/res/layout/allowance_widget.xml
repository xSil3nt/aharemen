<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="22dp" android:text="aharemen" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#edf5ed" android:includeFontPadding="false"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_data_balance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data" android:textSize="11sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
            <TextView android:id="@+id/widget_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="#a8ccea" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_add_data" android:layout_width="104dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:text="+50 MB" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="#a8ccea" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_voice_balance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calls" android:textSize="11sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
            <TextView android:id="@+id/widget_voice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="#edc3a2" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_add_voice" android:layout_width="104dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:text="+5 min" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="#edc3a2" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_sms_balance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Texts" android:textSize="11sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
            <TextView android:id="@+id/widget_sms" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="#b4e7c7" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_add_sms" android:layout_width="104dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:text="+50 SMS" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="#b4e7c7" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ProgressBar android:id="@+id/widget_progress" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="8dp" android:indeterminate="true" android:indeterminateTint="#b4e7c7" android:visibility="gone"/>
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Open aharemen to sign in" android:textColor="#9eafa5" android:textSize="10sp" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="match_parent" android:text="↻" android:textSize="24sp" android:gravity="center" android:textColor="#b4e7c7" android:contentDescription="Refresh allowances" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
