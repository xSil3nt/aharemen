<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="aharemen" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#edf5ed" android:includeFontPadding="false"/>
        <ProgressBar android:id="@+id/widget_progress" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="8dp" android:indeterminate="true" android:indeterminateTint="#b4e7c7" android:visibility="gone"/>
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="4dp" android:gravity="end|center_vertical" android:text="Open app" android:textColor="#9eafa5" android:textSize="10sp" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="match_parent" android:text="↻" android:textSize="22sp" android:gravity="center" android:textColor="#b4e7c7" android:contentDescription="Refresh allowances" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/widget_data_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Data" android:textSize="11sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_data" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:text="—" android:textSize="30sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#a8ccea" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_unit_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MB" android:textSize="10sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_data" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="9dp" android:background="@drawable/widget_button" android:text="+25 MB" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#a8ccea" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/widget_voice_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calls" android:textSize="11sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_voice" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:text="—" android:textSize="30sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#edc3a2" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_unit_voice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="min" android:textSize="10sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_voice" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="9dp" android:background="@drawable/widget_button" android:text="+3 min" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#edc3a2" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/widget_sms_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Texts" android:textSize="11sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_sms" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:text="—" android:textSize="30sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-medium" android:textColor="#b4e7c7" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_unit_sms" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SMS" android:textSize="10sp" android:textColor="#9eafa5" android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_add_sms" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="9dp" android:background="@drawable/widget_button" android:text="+10 SMS" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#b4e7c7" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
